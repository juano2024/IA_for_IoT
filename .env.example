# Copia este archivo como ".env" para personalizar el servidor.
#   Windows : Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Con Docker y Vagrant, las variables TEMP_*, HUM_* y DEVICE_API_KEY se
# aplican automaticamente. Las rutas solo se usan al ejecutar sin contenedor.

# --- Servidor (ejecucion nativa con `uv run ia-for-iot`) -----------------
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Persistencia (solo ejecucion nativa) --------------------------------
DATABASE_URL=sqlite:///./data/ia_for_iot.db
CSV_PATH=./data/lecturas.csv

# --- Rangos de confort del caso de uso -----------------------------------
TEMP_MIN=18
TEMP_MAX=22
HUM_MIN=40
HUM_MAX=60

# --- Seguridad (opcional) ------------------------------------------------
# Si se define, el ESP32 debe enviar la cabecera X-API-Key con este valor.
DEVICE_API_KEY=
