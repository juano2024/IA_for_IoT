// Copia este archivo a secrets.h y completa los valores. secrets.h NO se sube a git.
#pragma once

#define WIFI_SSID "TU_NOMBRE_WIFI"
#define WIFI_PASS "TU_CLAVE_WIFI"

// aws iot describe-endpoint --endpoint-type iot:Data-ATS
#define AWS_IOT_ENDPOINT "xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"

// Amazon Root CA 1 (https://www.amazontrust.com/repository/AmazonRootCA1.pem)
// El script scripts/aws_practica3.ps1 -Certs descarga los tres archivos en aws/certs/.
static const char AWS_CERT_CA[] = R"EOF(
-----BEGIN CERTIFICATE-----
PEGA_AQUI_AmazonRootCA1.pem
-----END CERTIFICATE-----
)EOF";

// Certificado del dispositivo (aws/certs/device.pem.crt)
static const char AWS_CERT_CRT[] = R"KEY(
-----BEGIN CERTIFICATE-----
PEGA_AQUI_device.pem.crt
-----END CERTIFICATE-----
)KEY";

// Clave privada del dispositivo (aws/certs/private.pem.key)
static const char AWS_CERT_PRIVATE[] = R"KEY(
-----BEGIN RSA PRIVATE KEY-----
PEGA_AQUI_private.pem.key
-----END RSA PRIVATE KEY-----
)KEY";
