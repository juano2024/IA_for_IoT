# Variables del stack de la Practica 2 (mqtt/docker-compose.yml).
# Copia este archivo como mqtt/.env y cambia las contrasenas.
#   Windows    : Copy-Item mqtt/.env.example mqtt/.env
#   macOS/Linux: cp mqtt/.env.example mqtt/.env
#
# En Google Cloud no hace falta copiarlo: deploy/gcp_mqtt_startup.sh escribe
# mqtt/.env con las claves guardadas en los metadatos de la VM.

# --- Broker MQTT ---------------------------------------------------------
MQTT_USERNAME=iot
MQTT_PASSWORD=cambia-esta-clave

# --- InfluxDB --------------------------------------------------------------
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=cambia-esta-clave
INFLUX_TOKEN=cambia-este-token

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esta-clave

# --- Rangos de confort del cuarto de un bebe -------------------------------
# Temperatura 18-22 C y humedad relativa 40-60 %.
TEMP_MIN=18
TEMP_MAX=22
HUM_MIN=40
HUM_MAX=60
