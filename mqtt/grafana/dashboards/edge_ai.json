          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"prediccion\" and (r._field == \"clase\" or r._field == \"confianza\" or r._field == \"nivel\")) |> map(fn: (r) => ({r with _value: string(v: r._value)})) |> pivot(rowKey: [\"_time\", \"tipo\", \"dispositivo\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> group() |> sort(columns: [\"_time\"], desc: true) |> limit(n: 30) |> keep(columns: [\"_time\", \"tipo\", \"dispositivo\", \"clase\", \"confianza\", \"nivel\"])",
          "rawQuery": true,
          "resultFormat": "table"
        }
      ],
