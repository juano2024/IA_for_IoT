    {
      "id": 1,
      "type": "stat",
      "title": "Temperatura actual",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-iot"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-iot"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"clima\" and r._field == \"temperatura_c\") |> keep(columns: [\"_time\", \"_value\", \"_field\", \"dispositivo\"]) |> group(columns: [\"_field\", \"dispositivo\"]) |> sort(columns: [\"_time\"]) |> last()",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 15
              },
              {
                "color": "red",
